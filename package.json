{
  "name": "aplikacja-treningowa",
  "version": "1.0.0",
  "description": "Profesjonalna aplikacja do śledzenia treningów",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "lint": "eslint js/",
    "lint:fix": "eslint js/ --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write js/",
    "format:check": "prettier --check js/"
  },
  "dependencies": {
    "firebase": "^10.8.0"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "vitest": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "happy-dom": "^14.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
