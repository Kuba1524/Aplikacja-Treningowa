{
  "name": "aplikacja-treningowa",
  "version": "1.0.0",
  "description": "Profesjonalna aplikacja do śledzenia treningów",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
